# n8n 自托管验证环境（SQLite 单容器）
N8N_ENCRYPTION_KEY=coolai-dev-encryption-key-change-me
# DeepSeek（感知/决策节点调用）
DEEPSEEK_API_KEY=sk-xxxxxxxx
DEEPSEEK_MODEL=deepseek-v4-flash
# 一键引导 owner + public API key（bootstrap.py）
N8N_OWNER_EMAIL=admin@coolai.local
N8N_OWNER_PASSWORD=CoolaiN8nDev2026!
N8N_API_KEY_LABEL=coolai-cli

# 审批通知网关（Apprise 侧车）
# 默认指向 compose 内的 apprise 服务；如外部自建 Apprise 可覆盖
APPRISE_NOTIFY_URL=http://apprise:8000/notify/

# 通知渠道：逗号分隔的 Apprise URL，注入 Apprise 的 APPRISE_STATELESS_URLS。
# 飞书/Lark 机器人：lark://<app_id>:<app_secret>@<...>
# 钉钉机器人：dingtalk://<token>
# 企业微信机器人：wecombot://<key>
# 例（仅示意，勿写死客户业务）：APPRISE_STATELESS_URLS=wecombot://xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
APPRISE_STATELESS_URLS=
